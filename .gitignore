# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 例外：模板文件只含占位符，必须能提交，否则别人无法复现环境
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database —— SQLite 数据库文件绝不能提交
# dev.db 内含用户表与邮箱等本地数据，且二进制文件会污染仓库历史
*.db
*.db-journal
*.sqlite
*.sqlite3
prisma/dev.db

# agent 工作记录（含项目内部实现细节，不对外公开）
.workbuddy/
