# 环境变量模板 —— 复制为 .env.local 并填入真实值
# cp .env.example .env.local
#
# 本项目用 .env.local（已被 .gitignore 忽略），不提交任何真实值。

# ── 数据库 ─────────────────────────────────────────────
# SQLite 本地文件（相对 prisma/ 目录）。换 Postgres 改这一行即可：
#   DATABASE_URL="postgresql://user:password@localhost:5432/mydb?connection_limit=10&pool_timeout=20"
DATABASE_URL="file:./dev.db"

# ── Auth.js ────────────────────────────────────────────
# 必填，JWT 签名的密钥。生成方式（不要复用示例值）：
#   openssl rand -base64 32
AUTH_SECRET=""

# Auth.js 自身的 baseURL。本地开发通常留空让框架自动推断；
# 部署到域名后填 https://your-domain.com
AUTH_URL="http://localhost:3000"

# ── 功能开关 ───────────────────────────────────────────
NEXT_PUBLIC_ENABLE_I18N="1"
